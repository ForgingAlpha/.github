{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Weekly routine dependency proposals for ForgingAlpha",
  "extends": ["local>ForgingAlpha/.github:renovate-config"],
  "packageRules": [
    {
      "description": "Propose each major upgrade independently",
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "Create and refresh the routine batch on Tuesday",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "schedule": ["* * * * 2"],
      "updateNotScheduled": false
    }
  ]
}
